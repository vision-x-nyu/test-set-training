    <!-- Hero Section -->
    <header class=3D"hero">
        <div class=3D"container hero-content fade-in-up visible">
            <span class=3D"hero-tag">=F0=9F=8C=B6=EF=B8=8F&nbsp;&nbsp;Hot T=
ake</span>
            <h1>Benchmark Designers Should<br>"Train on the Test Set"</h1>
            <p style=3D"font-size: 1.5rem; margin-top: 1rem; color: var(--t=
ext-secondary);">
                ...to expose and mitigate exploitable non-visual shortcuts.
            </p>

            <div class=3D"authors-container">
                <div class=3D"authors-list">
                    <div class=3D"author-item"><a href=3D"https://ellisbrow=
n.github.io/">Ellis Brown</a></div>
                    <div class=3D"author-item"><a href=3D"https://jihanyang=
.github.io/">Jihan Yang</a></div>
                    <div class=3D"author-item"><a href=3D"https://github.co=
m/vealocia">Shusheng Yang</a></div>
                    <div class=3D"author-item"><a href=3D"https://cs.nyu.ed=
u/~fergus/">Rob Fergus</a></div>
                    <div class=3D"author-item"><a href=3D"https://www.saini=
ngxie.com/">Saining Xie</a></div>
                </div>
                <div class=3D"institutions">New York University</div>
                <div class=3D"venue">Preprint, Nov. 2025</div>
            </div>


            <div class=3D"hero-buttons">
                <a href=3D"https://arxiv.org/abs/2511.04655" class=3D"btn b=
tn-primary">
                    <i class=3D"ai ai-arxiv"></i>arXiv
                </a>
                <a href=3D"https://arxiv.org/pdf/2511.04655" class=3D"btn b=
tn-secondary">
