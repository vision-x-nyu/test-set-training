g" class=3D"btn btn-secondary">
                    <i class=3D"fa-brands fa-github"></i> GitHub
                </a>
                <a href=3D"https://x.com/_ellisbrown/status/198801443664532=
7220" class=3D"btn btn-secondary">
                    <i class=3D"fa-brands fa-twitter"></i> Thread
                </a>
            </div>
