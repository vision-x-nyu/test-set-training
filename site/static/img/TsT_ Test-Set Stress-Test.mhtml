tion); font-size: 1rem; }

.btn-primary { background: var(--accent-gradient); color: white; box-shadow=
: rgba(255, 69, 0, 0.3) 0px 4px 15px; }

.btn-primary:hover { transform: translateY(-2px); box-shadow: rgba(255, 69,=
 0, 0.4) 0px 8px 25px; color: white; }

.btn-secondary { background: rgba(255, 255, 255, 0.05); color: var(--text-p=
rimary); border: 1px solid rgba(255, 255, 255, 0.1); }

.btn-secondary:hover { background: rgba(255, 255, 255, 0.1); border-color: =
rgba(255, 255, 255, 0.2); color: white; }

.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px=
, 1fr)); gap: 2rem; margin-top: 3rem; }

.card { background: var(--surface-color); padding: 2rem; border-radius: var=
